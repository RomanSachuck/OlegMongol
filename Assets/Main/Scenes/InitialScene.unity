  _loadingInfoText: {fileID: 671308702}
  _loadingInfo:
  - "\u041D\u0435 \u043C\u043E\u0433\u0443 \u043D\u0430\u0439\u0442\u0438 \u0418\u0440\u0438\u0448\u043A\u0443..."
  - "\u0412 \u043F\u0435\u0440\u0432\u044B\u0439 \u0440\u0430\u0437 \u0432\u0441\u0435\u0433\u0434\u0430
    \u0434\u043E\u043B\u0433\u043E..."
  - "\u0417\u0432\u043E\u043D\u044E \u0411\u0435\u0437\u0443\u043C\u043D\u043E\u043C\u0443
    \u041F\u0430\u0448\u043A\u0435..."
  - "\u041E\u0441\u0442\u0430\u043B\u043E\u0441\u044C \u0447\u0443\u0442\u043E\u043A,
    \u043E\u0442\u0432\u0435\u0447\u0430\u044E..."
  - "\u042F \u0441\u0442\u043E\u044E \u0437\u0430 \u0432\u043E\u0440\u043E\u0442\u0430\u043C\u0438
    \u0438 \u0436\u0434\u0443..."
  - "\u0412\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u044E \u0442\u0430\u043D\u0435\u0446..."
  - "\u041E\u043F\u0430! \u041D\u0430\u0448\u0435\u043B \u0418\u0440\u0438\u0448\u043A\u0443!.."
  - "\u0425\u043E\u0447\u0435\u0448\u044C, \u0440\u0430\u0441\u0441\u043A\u0430\u0436\u0443
    \u0430\u043D\u0435\u043A\u0434\u043E\u0442?.."
  - "\u0412\u0441\u0435, \u043F\u043E\u0440\u0430 \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u0442\u044C,
    \u0437\u0430\u043F\u0443\u0441\u043A\u0430\u0435\u043C!!!"
  - "\u041F\u043E\u0442\u0435\u0440\u043F\u0438 \u0440\u043E\u0434\u043D\u043E\u0439,
    \u0443\u0436\u0435 \u0441\u043A\u043E\u0440\u043E..."
